# Acdyon Job Ingestion Subsystem — Environment Configuration
# Copy this file to .env for local overrides. Do NOT commit real secrets to source control.

# Application Server Port
PORT=8000

# Allowed CORS Origins (comma-separated).
# Default: Empty (restricted to same-origin serving). For local dev: http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=

# PostgreSQL / Supabase Persistence Backend (Optional for local memory mode, Required for production database)
# Leave blank to run with non-persistent InMemoryStorage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
